set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-sessionist'
set -g @plugin 'tmux-plugins/tmux-pain-control'
set -g @plugin 'catppuccin/tmux'

set -g @catppuccin_flavor 'mocha'
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

{{ if eq .osid "darwin" -}}
# Use Fish as the shell by default
set -g default-command /opt/homebrew/bin/fish
set -g default-shell /opt/homebrew/bin/fish
{{- end -}}

# remap prefix to Control + a
set -g prefix C-a

# windows are 1-based (default is 0-based)
set -g base-index 1

# Disable arrow keys for switching panes
unbind Left
unbind Down
unbind Up
unbind Right

set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line

# Don't truncate window names (tmux-sensible sets a 10-char limit)
set -g window-status-current-format '#I:#W#F'

# Initialize tpack (keep this line at the very bottom of tmux.conf)
run 'tpack init'
